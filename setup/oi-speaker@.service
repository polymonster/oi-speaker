[Unit]
Description=Oi! Speaker!!
After=network-online.target sound.target pulseaudio.service sys-devices-platform-soc.subsystem.device
Wants=network-online.target

[Service]
Type=simple
User=%i
# '-' so a missing or already-running pulseaudio (eg. pipewire-pulse) doesn't fail the unit
ExecStartPre=-/usr/bin/pulseaudio --start
# WorkingDirectory, EnvironmentFile, XDG_RUNTIME_DIR and PULSE_SERVER are supplied by the
# drop-in that install-service.sh writes — %h and %U are NOT influenced by User= in a system
# unit (%h is always /root), so they can't be used here.
Environment=OI_SPEAKER_ARGS=
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/env ${OI_SPEAKER_PYTHON} -u src/speaker.py --verbose --service $OI_SPEAKER_ARGS
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
